@page "/users"
@using Web.Models
@using System.Net.Http.Json
@inject HttpClient Http
@rendermode InteractiveServer

<style>
.users-container { display: flex; flex-direction: column; gap: 1rem; }
.search-row { display:flex; gap:0.5rem; align-items:center; margin-bottom:0.75rem; }
.search-row .form-control { flex:1; }
.table thead { background:#f8f9fa; }
</style>

<h3>Listar Usuários</h3>

<div class="users-container">
    <div class="search-row">
        <input class="form-control" placeholder="Buscar por nome ou email" value="@_search" @oninput="OnSearchInput" />
        <button class="btn btn-outline-light" @onclick="ClearFilter">Limpar</button>
    </div>
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="error-label">@_errorMessage</div>
    }

    @if (_isLoading)
    {
        <div class="d-flex align-items-center text-muted">
            <div class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></div>
            Carregando dados...
        </div>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nome</th>
                    <th>Email</th>
                    <th>Departamento</th>
                    <th>Perfil</th>
                    <th>Status</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in _filtered)
                {
                    <tr>
                        <td>@u.Id</td>
                        <td>@u.Name</td>
                        <td>@u.Email</td>
                        <td>@u.Department?.Name</td>
                        <td>@u.UserProfile?.Name</td>
                        <td>@u.UserStatus?.Name</td>
                        <td>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => OpenConfirmDelete(u.Id, u.Name)">Remover</button>
                            <button class="btn btn-sm btn-outline-warning" @onclick="() => OpenEditModal(u.Id)">Editar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (_showConfirmModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar remoção</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseConfirm"></button>
                </div>
                <div class="modal-body">
                    <p>Confirma remoção de "<strong>@_confirmName</strong>" (id: @_confirmId)?</p>
                    <p class="text-muted">A ação não pode ser desfeita.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-success" @onclick="CloseConfirm">Cancelar</button>
                    <button class="btn btn-outline-danger" @onclick="ConfirmDelete">Remover</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showEditModal)
{
    <!-- Edit modal: same pattern as create form, but Name is read-only -->
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Editar usuário</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseEditModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="_editModel" OnValidSubmit="HandleEditSubmit">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Nome</label>
                                <InputText class="form-control" @bind-Value="_editModel.Name" disabled />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Email <span class="text-danger">*</span></label>
                                <InputText class="form-control" @bind-Value="_editModel.Email" />
                                <ValidationMessage For="() => _editModel.Email" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Senha</label>
                                <InputText class="form-control" type="password" @bind-Value="_editModel.Password" placeholder="Preencha para alterar a senha" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Departamento <span class="text-danger">*</span></label>
                                <InputSelect class="form-select" @bind-Value="_editModel.DeptId">
                                    <option value="0">-- selecione --</option>
                                    @if (_depts != null)
                                    {
                                        foreach (var d in _depts)
                                        {
                                            <option value="@d.Id">@d.Name</option>
                                        }
                                    }
                                </InputSelect>
                                <ValidationMessage For="() => _editModel.DeptId" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Perfil <span class="text-danger">*</span></label>
                                <InputSelect class="form-select" @bind-Value="_editModel.ProfileId">
                                    <option value="0">-- selecione --</option>
                                    @if (_profiles != null)
                                    {
                                        foreach (var p in _profiles)
                                        {
                                            <option value="@p.Id">@p.Name</option>
                                        }
                                    }
                                </InputSelect>
                                <ValidationMessage For="() => _editModel.ProfileId" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Status <span class="text-danger">*</span></label>
                                <InputSelect class="form-select" @bind-Value="_editModel.UserStatusId">
                                    <option value="0">-- selecione --</option>
                                    @if (_statuses != null)
                                    {
                                        foreach (var s in _statuses)
                                        {
                                            <option value="@s.Id">@s.Name</option>
                                        }
                                    }
                                </InputSelect>
                                <ValidationMessage For="() => _editModel.UserStatusId" />
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="button" class="btn btn-outline-secondary" @onclick="CloseEditModal">Cancelar</button>
                            <button type="submit" class="btn btn-outline-primary" disabled="@_editIsSubmitting">
                                @if (_editIsSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                }
                                Salvar
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<UserDto> _users = new();
    private List<UserDto> _filtered = new();

    private string _search = string.Empty;
    private bool _isLoading = true;
    private string? _errorMessage;

    // confirm modal state
    private bool _showConfirmModal;
    private int _confirmId;
    private string? _confirmName;

    // edit modal state
    private bool _showEditModal;
    private int _editingId;
    private UpdateUserDto _editModel = new();
    private bool _editIsSubmitting;

    private List<DepartmentDto>? _depts;
    private List<UserProfileDto>? _profiles;
    private List<UserStatusDto>? _statuses;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            _users = await Http.GetFromJsonAsync<List<UserDto>>("/users") ?? new List<UserDto>();
            _filtered = _users.ToList();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e?.Value?.ToString() ?? string.Empty;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var q = _search.Trim().ToLowerInvariant();
        if (string.IsNullOrEmpty(q))
        {
            _filtered = _users.ToList();
        }
        else
        {
            _filtered = _users.Where(u => (u.Name ?? string.Empty).ToLower().Contains(q) || (u.Email ?? string.Empty).ToLower().Contains(q)).ToList();
        }
        StateHasChanged();
    }

    private void ClearFilter()
    {
        _search = string.Empty;
        _filtered = _users.ToList();
    }

    private void OpenConfirmDelete(int id, string? name)
    {
        _confirmId = id;
        _confirmName = name;
        _showConfirmModal = true;
    }

    private void CloseConfirm()
    {
        _showConfirmModal = false;
        _confirmId = 0;
        _confirmName = null;
    }

    private async Task ConfirmDelete()
    {
        _showConfirmModal = false;
        try
        {
            var resp = await Http.DeleteAsync($"/users/{_confirmId}");
            if (resp.IsSuccessStatusCode)
            {
                await LoadDataAsync();
            }
            else
            {
                var text = await resp.Content.ReadAsStringAsync();
                _errorMessage = $"Erro ao remover: {(int)resp.StatusCode} - {text}";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _confirmId = 0;
            _confirmName = null;
        }
    }

    private async Task OpenEditModal(int id)
    {
        _editingId = id;
        _errorMessage = null;
        try
        {
            // ensure lookups
            if (_depts == null) _depts = await Http.GetFromJsonAsync<List<DepartmentDto>>("/departments");
            if (_profiles == null) _profiles = await Http.GetFromJsonAsync<List<UserProfileDto>>("/profiles");
            if (_statuses == null) _statuses = await Http.GetFromJsonAsync<List<UserStatusDto>>("/userstatuses");

            var user = await Http.GetFromJsonAsync<UserDto>($"/users/{id}");
            if (user == null)
            {
                _errorMessage = "Usuário não encontrado.";
                return;
            }

            _editModel = new UpdateUserDto
            {
                Name = user.Name,
                Email = user.Email,
                DeptId = user.Department?.Id ?? 0,
                ProfileId = user.UserProfile?.Id ?? 0,
                UserStatusId = user.UserStatus?.Id ?? 0,
                Password = null
            };

            _showEditModal = true;
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task HandleEditSubmit()
    {
        _errorMessage = null;
        if (_editingId <= 0) { _errorMessage = "Id do usuário inválido."; return; }

        // basic client-side validations
        if (_editModel.DeptId <= 0) { _errorMessage = "Selecione um Departamento."; return; }
        if (_editModel.ProfileId <= 0) { _errorMessage = "Selecione um Perfil."; return; }
        if (_editModel.UserStatusId <= 0) { _errorMessage = "Selecione um Status."; return; }
        if (string.IsNullOrWhiteSpace(_editModel.Email)) { _errorMessage = "O campo Email é obrigatório."; return; }

        try
        {
            _editIsSubmitting = true;
            var response = await Http.PutAsJsonAsync($"/users/{_editingId}", _editModel);
            if (response.IsSuccessStatusCode)
            {
                _showEditModal = false;
                await LoadDataAsync();
                return;
            }
            else
            {
                var text = await response.Content.ReadAsStringAsync();
                try
                {
                    var map = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(text);
                    if (map != null && (map.TryGetValue("message", out var m) || map.TryGetValue("Message", out m)))
                    {
                        _errorMessage = m;
                    }
                    else
                    {
                        _errorMessage = text;
                    }
                }
                catch
                {
                    _errorMessage = text;
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _editIsSubmitting = false;
        }
    }

    private void CloseEditModal()
    {
        _showEditModal = false;
        _editModel = new UpdateUserDto();
        _editingId = 0;
    }
}
