@page "/my-tickets"
@using Web.Models
@rendermode InteractiveServer

<PageTitle>Meus chamados</PageTitle>

<h1>Meus chamados</h1>

@if (_tickets == null)
{
    <div class="d-flex align-items-center text-muted">
        <div class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></div>
        Carregando dados...
    </div>
}
else if (!_tickets.Any())
{
    <p><em>Nenhum chamado atribuído.</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover table-bordered">
            <thead class="table-light">
                <tr>
                    <th class="text-center sortable" @onclick='() => SetSort("Id")'>
                        ID <span class="ms-2 @GetIndicatorClass("Id")">@GetColumnIndicator("Id")</span>
                    </th>
                    <th class="text-center sortable" @onclick='() => SetSort("Description")'>
                        Descrição <span class="ms-2 @GetIndicatorClass("Description")">@GetColumnIndicator("Description")</span>
                    </th>
                    <th class="text-center sortable" @onclick='() => SetSort("User")'>
                        Usuário <span class="ms-2 @GetIndicatorClass("User")">@GetColumnIndicator("User")</span>
                    </th>
                    <th class="text-center sortable" @onclick='() => SetSort("Department")'>
                        Departamento <span class="ms-2 @GetIndicatorClass("Department")">@GetColumnIndicator("Department")</span>
                    </th>
                    <th class="text-center sortable" @onclick='() => SetSort("Status")'>
                        Status <span class="ms-2 @GetIndicatorClass("Status")">@GetColumnIndicator("Status")</span>
                    </th>
                    <th class="text-center sortable" @onclick='() => SetSort("Date")'>
                        Data <span class="ms-2 @GetIndicatorClass("Date")">@GetColumnIndicator("Date")</span>
                    </th>
                    <th class="text-center">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ticket in _sortedTickets)
                {
                    <tr>
                        <td class="text-center">@ticket.Id</td>
                        <td class="text-center">@ticket.Description</td>
                        <td class="text-center">@ticket.User?.Name</td>
                        <td class="text-center">@ticket.Department?.Name</td>
                        <td class="text-center"><span class="badge bg-info">@FormatStatus(ticket.StatusTicket?.Name)</span></td>
                        <td class="text-center">@ticket.OpenDateTime?.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        <td class="text-center">
                            <button class="btn btn-outline-warning btn-sm me-1" @onclick="() => ShowDetails(ticket)" title="Detalhes"><i class="bi bi-eye"></i> Detalhes</button>
                            <button class="btn btn-outline-primary btn-sm me-1" @onclick="() => ShowChat(ticket)" title="Chat"><i class="bi bi-chat-dots"></i> Chat</button>
                            @if (!string.Equals(ticket.StatusTicket?.Name, "Fechado", StringComparison.OrdinalIgnoreCase))
                            {
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => CloseTicket(ticket)" title="Fechar"><i class="bi bi-check2-circle"></i> Fechar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Modais (detalhes e chat) mantidos -->
<div class="modal fade" id="detailsModal" tabindex="-1" aria-labelledby="detailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="detailsModalLabel">Detalhes do Chamado #@(_selectedTicket?.Id)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @if (_selectedTicket != null)
                {
                    <div class="mb-3">
                        <label class="form-label">Descrição</label>
                        <p>@_selectedTicket.Description</p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Usuário</label>
                        <p>@_selectedTicket.User?.Name</p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Departamento</label>
                        <p>@_selectedTicket.Department?.Name</p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Categoria</label>
                        <p>@_selectedTicket.Category?.Name</p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Prioridade</label>
                        <p>@_selectedTicket.PriorityLevel</p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <p>@FormatStatus(_selectedTicket.StatusTicket?.Name)</p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Data de Abertura</label>
                        <p>@_selectedTicket.OpenDateTime?.ToString("dd/MM/yyyy HH:mm")</p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Anexos (@_attachments.Count)</label>
                        @if (_attachments.Any())
                        {
                            @foreach (var attach in _attachments)
                            {
                                var a = attach?.Trim();
                                if (!string.IsNullOrEmpty(a))
                                {
                                    <div class="mb-2">
                                        <div class="mt-2">
                                            <img src="@ToApiUrl(a)" alt="Anexo do chamado" class="img-thumbnail" style="max-height:180px" onerror="this.onerror=null; this.src='@ProxyUrl(a)';" />
                                        </div>
                                        <a href="@ToApiUrl(a)" target="_blank" class="btn btn-sm btn-outline-primary">Download Anexo</a>
                                    </div>
                                }
                            }
                        }
                        else
                        {
                            <div class="text-muted">Sem anexos</div>
                        }
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="chatModal" tabindex="-1" aria-labelledby="chatModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="chatModalLabel">Chat do Chamado #@(_selectedTicket?.Id)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @if (_transactions != null)
                {
                    @foreach (var tx in _transactions)
                    {
                        <div class="mb-3">
                            <strong>@tx.UserSource?.Name</strong> (@tx.CreatedAt?.ToString("dd/MM/yyyy HH:mm"))<br />
                            @tx.Body
                            @if (!string.IsNullOrEmpty(tx.AttachUrl))
                            {
                                <br /><a href="@ToApiUrl(tx.AttachUrl)" target="_blank">Ver Anexo</a>
                            }
                        </div>
                    }
                }
                <div class="mb-3">
                    <label class="form-label">Nova Mensagem</label>
                    <textarea class="form-control" @bind="_newMessage" rows="3"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" @onclick="async () => await SendMessage()">Enviar</button>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Ticket>? _tickets;
    private List<Ticket> _sortedTickets = new();
    private Ticket? _selectedTicket;
    private List<TicketTransactionDto> _transactions = new();
    private List<string> _attachments = new();
    private string _newMessage = "";
    private string _sortColumn = "Id";
    private bool _sortAscending = true;

    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private IJSRuntime Js { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;

    protected override Task OnInitializedAsync()
    {
        // Defer JS interop and data loading to OnAfterRenderAsync due to prerendering
        _tickets = null; // shows loading
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var userId = await GetCurrentUserIdAsync();
        if (userId == null)
        {
            // Avoid blocking prerender; small delay after first render is safe for JS alert
            try { await Js.InvokeVoidAsync("alert", "Sessão expirada. Faça login novamente."); } catch { }
            Nav.NavigateTo("/login", true);
            return;
        }
        try
        {
            _tickets = await Http.GetFromJsonAsync<List<Ticket>>($"tickets/assigned/{userId.Value}") ?? new();
        }
        catch
        {
            _tickets = new();
        }
        ApplySorting();
        StateHasChanged();
    }

    private string FormatStatus(string? name) => string.Equals(name, "Em Progresso", StringComparison.OrdinalIgnoreCase) ? "Atendendo" : (name ?? "");

    private async Task ShowDetails(Ticket ticket)
    {
        _selectedTicket = ticket;
        await LoadAttachments(ticket.Id);
        await LoadTransactions(ticket.Id);
        await Js.InvokeVoidAsync("eval", "new bootstrap.Modal(document.getElementById('detailsModal')).show()");
    }

    private async Task ShowChat(Ticket ticket)
    {
        _selectedTicket = ticket;
        await LoadTransactions(ticket.Id);
        await Js.InvokeVoidAsync("eval", "new bootstrap.Modal(document.getElementById('chatModal')).show()");
    }

    private async Task CloseTicket(Ticket ticket)
    {
        try
        {
            // Resolve status "Fechado"
            var statuses = await Http.GetFromJsonAsync<List<StatusTicketDto>>("statustickets") ?? new();
            var closed = statuses.FirstOrDefault(s => string.Equals(s.Name, "Fechado", StringComparison.OrdinalIgnoreCase));
            if (closed == null)
            {
                await Js.InvokeVoidAsync("alert", "Status 'Fechado' não encontrado.");
                return;
            }

            ticket.StatusId = closed.Id;
            var resp = await Http.PutAsJsonAsync($"tickets/{ticket.Id}", ticket);
            if (!resp.IsSuccessStatusCode)
            {
                await Js.InvokeVoidAsync("alert", $"Falha ao fechar o chamado: {(int)resp.StatusCode}");
                return;
            }

            // Recarrega a lista de "Meus chamados" (exclui fechados)
            var userId = await GetCurrentUserIdAsync();
            _tickets = await Http.GetFromJsonAsync<List<Ticket>>($"tickets/assigned/{userId}") ?? new();
            ApplySorting();
        }
        catch (Exception ex)
        {
            await Js.InvokeVoidAsync("alert", $"Erro ao fechar chamado: {ex.Message}");
        }
    }

    private async Task SendMessage()
    {
        if (_selectedTicket != null && !string.IsNullOrEmpty(_newMessage))
        {
            var currentUserId = await GetCurrentUserIdAsync();
            if (currentUserId == null)
            {
                await Js.InvokeVoidAsync("alert", "Não foi possível identificar o usuário logado. Faça login novamente.");
                return;
            }

            var tx = new
            {
                UserSourceId = currentUserId.Value,
                UserTargetId = (int?)null,
                Body = _newMessage,
                TicketId = _selectedTicket.Id,
                CreatedAt = DateTime.UtcNow
            };
            await Http.PostAsJsonAsync("tickettransactions", tx);
            _newMessage = "";
            await LoadTransactions(_selectedTicket.Id);
        }
    }

    private async Task LoadAttachments(int ticketId)
    {
        try
        {
            var urls = await Http.GetFromJsonAsync<List<string>>($"tickets/{ticketId}/attachments");
            _attachments = urls?.Select(u => u?.Trim()).Where(u => !string.IsNullOrEmpty(u)).Cast<string>().ToList() ?? new();
        }
        catch
        {
            _attachments = new();
        }
    }

    private async Task LoadTransactions(int ticketId)
    {
        try
        {
            var resp = await Http.GetAsync($"tickettransactions/ticket/{ticketId}");
            if (resp.IsSuccessStatusCode)
            {
                _transactions = await resp.Content.ReadFromJsonAsync<List<TicketTransactionDto>>() ?? new();
            }
            else
            {
                _transactions = new();
            }
        }
        catch
        {
            _transactions = new();
        }
    }

    private async Task<int?> GetCurrentUserIdAsync()
    {
        try
        {
            var idStr = await Js.InvokeAsync<string>("localStorage.getItem", "userId");
            if (!string.IsNullOrWhiteSpace(idStr) && int.TryParse(idStr, out var id))
            {
                return id;
            }
        }
        catch { }
        return null;
    }

    private string ToApiUrl(string path)
    {
        var baseUrl = Http.BaseAddress?.ToString().TrimEnd('/') ?? string.Empty;
        if (string.IsNullOrWhiteSpace(path)) return string.Empty;
        if (Uri.IsWellFormedUriString(path, UriKind.Absolute)) return path;
        if (path.StartsWith('/')) return baseUrl + path;
        return $"{baseUrl}/{path}";
    }

    private string ProxyUrl(string path)
    {
        if (string.IsNullOrWhiteSpace(path)) return string.Empty;
        var trimmed = path.TrimStart('/');
        if (trimmed.StartsWith("uploads", StringComparison.OrdinalIgnoreCase))
        {
            var rest = trimmed.Substring("uploads".Length).TrimStart('/');
            return "/files/" + rest;
        }
        return "/files/" + trimmed;
    }

    private void SetSort(string column)
    {
        if (_sortColumn == column)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }

        ApplySorting();
        StateHasChanged();
    }

    private void ApplySorting()
    {
        if (_tickets == null) return;
        if (_sortColumn == "Id")
        {
            _sortedTickets = _sortAscending ? _tickets.OrderBy(t => t.Id).ToList() : _tickets.OrderByDescending(t => t.Id).ToList();
        }
        else if (_sortColumn == "Description")
        {
            _sortedTickets = _sortAscending ? _tickets.OrderBy(t => t.Description).ToList() : _tickets.OrderByDescending(t => t.Description).ToList();
        }
        else if (_sortColumn == "User")
        {
            _sortedTickets = _sortAscending ? _tickets.OrderBy(t => t.User?.Name).ToList() : _tickets.OrderByDescending(t => t.User?.Name).ToList();
        }
        else if (_sortColumn == "Department")
        {
            _sortedTickets = _sortAscending ? _tickets.OrderBy(t => t.Department?.Name).ToList() : _tickets.OrderByDescending(t => t.Department?.Name).ToList();
        }
        else if (_sortColumn == "Status")
        {
            _sortedTickets = _sortAscending ? _tickets.OrderBy(t => t.StatusTicket?.Name).ToList() : _tickets.OrderByDescending(t => t.StatusTicket?.Name).ToList();
        }
        else if (_sortColumn == "Date")
        {
            _sortedTickets = _sortAscending ? _tickets.OrderBy(t => t.OpenDateTime).ToList() : _tickets.OrderByDescending(t => t.OpenDateTime).ToList();
        }
    }

    private string GetColumnIndicator(string column)
    {
        if (_sortColumn != column) return "";
        return _sortAscending ? "▲" : "▼";
    }

    private string GetIndicatorClass(string column)
    {
        return _sortColumn == column ? "fw-bold" : string.Empty;
    }
}

<style>
    .sortable { cursor: pointer; user-select: none; }
</style>
