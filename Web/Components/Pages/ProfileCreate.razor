@page "/profiles/create"
@using Web.Models
@inject HttpClient Http
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<h3 class="mb-3"><span class="bi bi-person-gear me-2"></span>Criar Perfil</h3>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger" role="alert">
        <span class="bi bi-exclamation-triangle me-2"></span>@_errorMessage
    </div>
}

<EditForm Model="_model" OnValidSubmit="HandleSubmit" FormName="CreateProfileForm">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger mb-3" />

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="row g-3">
                <div class="col-12">
                    <h5 class="section-title">Dados do perfil</h5>
                    <hr class="section-divider" />
                </div>
                <div class="col-md-8">
                    <label class="form-label">Nome <span class="text-danger">*</span></label>
                    <InputText class="form-control" @bind-Value="_model.Name" placeholder="Ex.: Agente, Administrador" />
                    <ValidationMessage For="() => _model.Name" />
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <button class="btn btn-secondary" type="button" @onclick="GoBack">
                    <span class="bi bi-arrow-left me-1"></span> Voltar
                </button>
                <button class="btn btn-primary" type="submit" disabled="@_isSubmitting">
                    @if (_isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    }
                    <span class="bi bi-check2-circle me-1"></span> Criar
                </button>
            </div>
        </div>
    </div>
</EditForm>

@code {
    private CreateUserProfileDto _model = new();
    private string? _errorMessage;
    private bool _isSubmitting;

    private async Task HandleSubmit()
    {
        _errorMessage = null;
        if (string.IsNullOrWhiteSpace(_model.Name))
        {
            _errorMessage = "Informe o nome do perfil.";
            return;
        }

        try
        {
            _isSubmitting = true;
            var payload = new { Name = _model.Name?.Trim() };
            var response = await Http.PostAsJsonAsync("/profiles", payload);
            if (response.IsSuccessStatusCode)
            {
                NavigationManager.NavigateTo("/");
                return;
            }
            var text = await response.Content.ReadAsStringAsync();
            _errorMessage = text;
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void GoBack() => NavigationManager.NavigateTo("/");
}
