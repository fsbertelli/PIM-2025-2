@page "/closed-tickets"
@using Web.Models
@rendermode InteractiveServer

<PageTitle>Histórico de chamados</PageTitle>

<h1>    Histórico de chamados</h1>

@if (_tickets == null)
{
    <div class="d-flex align-items-center text-muted">
        <div class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></div>
        Carregando dados...
    </div>
}
else if (!_tickets.Any())
{
    <p><em>Nenhum chamado fechado encontrado.</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover table-bordered">
            <thead class="table-light">
            <tr>
                <th class="text-center" @onclick='() => SetSort("Id")' style="cursor:pointer;">
                    <div class="d-flex align-items-center justify-content-center gap-2">
                        <span>ID</span>
                        <span class="@GetIndicatorClass("Id")">@GetColumnIndicator("Id")</span>
                    </div>
                </th>
                <th class="text-center" @onclick='() => SetSort("Description")' style="cursor:pointer;">
                    <div class="d-flex align-items-center justify-content-center gap-2">
                        <span>Descrição</span>
                        <span class="@GetIndicatorClass("Description")">@GetColumnIndicator("Description")</span>
                    </div>
                </th>
                <th class="text-center" @onclick='() => SetSort("User")' style="cursor:pointer;">
                    <div class="d-flex align-items-center justify-content-center gap-2">
                        <span>Usuário</span>
                        <span class="@GetIndicatorClass("User")">@GetColumnIndicator("User")</span>
                    </div>
                </th>
                <th class="text-center" @onclick='() => SetSort("Department")' style="cursor:pointer;">
                    <div class="d-flex align-items-center justify-content-center gap-2">
                        <span>Departamento</span>
                        <span class="@GetIndicatorClass("Department")">@GetColumnIndicator("Department")</span>
                    </div>
                </th>
                <th class="text-center" @onclick='() => SetSort("Status")' style="cursor:pointer;">
                    <div class="d-flex align-items-center justify-content-center gap-2">
                        <span>Status</span>
                        <span class="@GetIndicatorClass("Status")">@GetColumnIndicator("Status")</span>
                    </div>
                </th>
                <th class="text-center" @onclick='() => SetSort("Date")' style="cursor:pointer;">
                    <div class="d-flex align-items-center justify-content-center gap-2">
                        <span>Data</span>
                        <span class="@GetIndicatorClass("Date")">@GetColumnIndicator("Date")</span>
                    </div>
                </th>
                <th class="text-center">Ações</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var ticket in _sortedTickets)
            {
                <tr>
                    <td class="text-center">@ticket.Id</td>
                    <td class="text-center">
                        @if(ticket.Category?.Description is "Injúria Racial" or "Homofobia")
                        {
                            <span class="text-danger fw-bold">Conteúdo impróprio</span>
                        } else {
                            @ticket.Description
                        }
                    </td>
                    <td class="text-center">@ticket.User?.Name</td>
                    <td class="text-center">@ticket.Department?.Name</td>
                    <td class="text-center"><span class="badge bg-secondary">@FormatStatus(ticket.StatusTicket?.Name)</span></td>
                    <td class="text-center">@ticket.OpenDateTime?.ToString("dd/MM/yyyy HH:mm:ss")</td>
                    <td class="text-center">
                        <div class="d-flex align-items-center justify-content-center gap-2 flex-nowrap">
                            @if (ticket.Category?.Description == "Injúria Racial" || ticket.Category?.Description == "Homofobia")
                            {
                                <button class="btn btn-danger btn-sm me-1" @onclick='() => Js.InvokeVoidAsync("alert", "Compliance acionado")' title="Compliance">
                                    <i class="bi bi-eye"></i> Compliance
                                </button>
                            } else {
                            <button class="btn btn-outline-warning btn-sm" @onclick="() => ShowDetails(ticket)" title="Detalhes">
                                <i class="bi bi-eye"></i> Detalhes
                            </button>
                            <button class="btn btn-outline-primary btn-sm" @onclick="() => ShowChat(ticket)" title="Chat">
                                <i class="bi bi-chat-dots"></i> Chat
                            </button> 
                            <button class="btn btn-outline-success btn-sm" @onclick="() => ReOpen(ticket)" title="Chat">
                                <i class="bi bi-chat-dots"></i> Reabrir
                            </button> 
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    
    <!-- Modal de detalhes -->
    <div class="modal fade" id="detailsModal" tabindex="-1" aria-labelledby="detailsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow-lg rounded-3">

                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-semibold" id="detailsModalLabel">
                        Detalhes do Chamado #@(_selectedTicket?.Id)
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body p-4">
                    @if (_selectedTicket != null)
                    {
                        <div class="row g-3">

                            <div class="col-12">
                                <label class="fw-bold text-secondary">Descrição</label>
                                <div class="p-3 bg-light rounded border">@_selectedTicket.Description</div>
                            </div>

                            <div class="col-md-6">
                                <label class="fw-bold text-secondary">Usuário</label>
                                <div class="p-2 bg-light rounded border">@_selectedTicket.User?.Name</div>
                            </div>

                            <div class="col-md-6">
                                <label class="fw-bold text-secondary">Departamento</label>
                                <div class="p-2 bg-light rounded border">@_selectedTicket.Department?.Name</div>
                            </div>

                            <div class="col-md-6">
                                <label class="fw-bold text-secondary">Categoria</label>
                                <div class="p-2 bg-light rounded border">@FormatStatus(_selectedTicket.Category?.Description)</div>
                            </div>

                            <div class="col-md-6">
                                <label class="fw-bold text-secondary">Prioridade</label>
                                <div class="p-2 bg-light rounded border">@FormatStatus(_selectedTicket.PriorityLevel.ToString())</div>
                            </div>

                            <div class="col-md-6">
                                <label class="fw-bold text-secondary">Status</label>
                                <div class="p-2 bg-light rounded border">@FormatStatus(_selectedTicket.StatusTicket?.Name)</div>
                            </div>

                            <div class="col-md-6">
                                <label class="fw-bold text-secondary">Data de Abertura</label>
                                <div class="p-2 bg-light rounded border">
                                    @_selectedTicket.OpenDateTime?.ToString("dd/MM/yyyy HH:mm:ss")
                                </div>
                            </div>

                            <div class="col-12 mt-2">
                                <label class="fw-bold text-secondary">Anexos (@_attachments.Count)</label>

                                @if (_attachments.Any())
                                {
                                    <div class="row g-3 mt-1">
                                        @foreach (var attach in _attachments)
                                        {
                                            var a = attach?.Trim();
                                            if (!string.IsNullOrEmpty(a))
                                            {
                                                <div class="col-md-4 text-center">
                                                    <div class="border rounded p-2 bg-white">
                                                        <img src="@ToApiUrl(a)" 
                                                             alt="Anexo do chamado" 
                                                             class="img-fluid rounded" 
                                                             style="max-height:180px" 
                                                             onerror="this.onerror=null; this.src='@ProxyUrl(a)';" />

                                                        <a href="@ToApiUrl(a)" target="_blank" class="btn btn-sm btn-outline-primary mt-2 w-100">
                                                            Download
                                                        </a>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted fst-italic mt-1">Sem anexos</div>
                                }
                            </div>

                        </div>
                    }
                </div>

                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fechar</button>
                </div>

            </div>
        </div>
    </div>
    
<!-- Modal do Chat -->
    <div class="modal fade" id="chatModal" tabindex="-1" aria-labelledby="chatModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content shadow rounded-3 modal-chat">

                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-semibold" id="chatModalLabel">
                        Chamado #@(_selectedTicket?.Id) - @(_selectedTicket?.User?.Name) 
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body chat-scroll-area">
                    @if (_transactions != null)
                    {
                        <div class="chat-container">
                            @foreach (var tx in _transactions)
                            {
                                var isRight = tx.UserSource?.Department?.ToString() == "Suporte";

                                <div class="chat-bubble @(isRight ? "chat-right" : "chat-left")">

                                    <div class="chat-meta">
                                        @tx.UserSource?.Name • @tx.CreatedAt?.ToString("dd/MM/yyyy HH:mm:ss")
                                    </div>

                                    <div>@tx.Body</div>

                                    @if (!string.IsNullOrEmpty(tx.AttachUrl))
                                    {
                                        <div class="mt-2">
                                            <a href="@ToApiUrl(tx.AttachUrl)" target="_blank" class="btn btn-sm btn-outline-primary w-100">
                                                Ver Anexo
                                            </a>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Ticket>? _tickets;
    private List<Ticket> _sortedTickets = new();
    private string _sortColumn = "Id";
    private bool _sortAscending = true;
    private Ticket? _selectedTicket;
    private List<TicketTransactionDto> _transactions = new();
    private List<string> _attachments = new();
    private Timer? _pollTimer;
    private bool _isChatOpen = false;
    private string _newMessage = "";


    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private IJSRuntime Js { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;

    protected override Task OnInitializedAsync()
    {
        _tickets = null; 
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var userId = await GetCurrentUserIdAsync();
        if (userId == null)
        {
            try { await Js.InvokeVoidAsync("alert", "Sessão expirada. Faça login novamente."); } catch { }
            Nav.NavigateTo("/login", true);
            return;
        }
        try
        {
            _tickets = await Http.GetFromJsonAsync<List<Ticket>>($"tickets/assigned/{userId.Value}/closed") ?? new();
        }
        catch { _tickets = new(); }
        ApplySorting();
        StateHasChanged();
    }

    private string FormatStatus(string? name) => name ?? "";

    private async Task<int?> GetCurrentUserIdAsync()
    {
        try
        {
            var idStr = await Js.InvokeAsync<string>("localStorage.getItem", "userId");
            if (!string.IsNullOrWhiteSpace(idStr) && int.TryParse(idStr, out var id))
            {
                return id;
            }
        }
        catch { }
        return null;
    }

    private void SetSort(string column)
    {
        if (_sortColumn == column)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
        ApplySorting();
        StateHasChanged();
    }

    private string GetIndicatorClass(string column) => _sortColumn == column ? "fw-bold" : string.Empty;

    private string GetColumnIndicator(string column)
    {
        if (_sortColumn != column) return "";
        return _sortAscending ? "▲" : "▼";
    }

    private void ApplySorting()
    {
        if (_tickets == null) return;
        if (_sortColumn == "Id")
        {
            _sortedTickets = _sortAscending ? _tickets.OrderBy(t => t.Id).ToList() : _tickets.OrderByDescending(t => t.Id).ToList();
        }
        else if (_sortColumn == "Description")
        {
            _sortedTickets = _sortAscending ? _tickets.OrderBy(t => t.Description).ToList() : _tickets.OrderByDescending(t => t.Description).ToList();
        }
        else if (_sortColumn == "User")
        {
            _sortedTickets = _sortAscending ? _tickets.OrderBy(t => t.User?.Name).ToList() : _tickets.OrderByDescending(t => t.User?.Name).ToList();
        }
        else if (_sortColumn == "Department")
        {
            _sortedTickets = _sortAscending ? _tickets.OrderBy(t => t.Department?.Name).ToList() : _tickets.OrderByDescending(t => t.Department?.Name).ToList();
        }
        else if (_sortColumn == "Status")
        {
            _sortedTickets = _sortAscending ? _tickets.OrderBy(t => t.StatusTicket?.Name).ToList() : _tickets.OrderByDescending(t => t.StatusTicket?.Name).ToList();
        }
        else if (_sortColumn == "Date")
        {
            _sortedTickets = _sortAscending ? _tickets.OrderBy(t => t.OpenDateTime).ToList() : _tickets.OrderByDescending(t => t.OpenDateTime).ToList();
        }
    }

    private async Task ShowDetails(Ticket ticket)
    {
        _selectedTicket = ticket;
        await LoadAttachments(ticket.Id);
        await LoadTransactions(ticket.Id);
        await Js.InvokeVoidAsync("eval", "new bootstrap.Modal(document.getElementById('detailsModal')).show()");
    }

    private async Task LoadAttachments(int ticketId)
    {
        try
        {
            var urls = await Http.GetFromJsonAsync<List<string>>($"tickets/{ticketId}/attachments");
            _attachments = urls?.Select(u => u?.Trim()).Where(u => !string.IsNullOrEmpty(u)).Cast<string>().ToList() ?? new();
        }
        catch
        {
            _attachments = new();
        }
    }
    private async Task LoadTransactions(int ticketId)
    {
        try
        {
            var resp = await Http.GetAsync($"tickettransactions/ticket/{ticketId}");
            if (resp.IsSuccessStatusCode)
            {
                _transactions = await resp.Content.ReadFromJsonAsync<List<TicketTransactionDto>>() ?? new();
            }
            else
            {
                _transactions = new();
            }
        }
        catch
        {
            _transactions = new();
        }
    }
    private string ToApiUrl(string path)
    {
        var baseUrl = Http.BaseAddress?.ToString().TrimEnd('/') ?? string.Empty;
        if (string.IsNullOrWhiteSpace(path)) return string.Empty;
        if (Uri.IsWellFormedUriString(path, UriKind.Absolute)) return path;
        if (path.StartsWith('/')) return baseUrl + path;
        return $"{baseUrl}/{path}";
    }

    private string ProxyUrl(string path)
    {
        if (string.IsNullOrWhiteSpace(path)) return string.Empty;
        var trimmed = path.TrimStart('/');
        if (trimmed.StartsWith("uploads", StringComparison.OrdinalIgnoreCase))
        {
            var rest = trimmed.Substring("uploads".Length).TrimStart('/');
            return "/files/" + rest;
        }

        return "/files/" + trimmed;
    }
    private async Task ShowChat(Ticket ticket)
    {
        _selectedTicket = ticket;
        await LoadTransactions(ticket.Id);

        try
        {
            // Tenta abrir o modal; captura qualquer erro (ex.: circuito desconectado)
            await Js.InvokeVoidAsync("eval", "new bootstrap.Modal(document.getElementById('chatModal')).show()");
        }
        catch
        {
            // Ignorar erros de JSInterop — ainda assim as mensagens estarão carregadas no componente
        }

        // Atualiza UI com as transações carregadas
        await InvokeAsync(StateHasChanged);
    }
    
    private async Task SendMessage()
    {
        if (_selectedTicket == null || string.IsNullOrWhiteSpace(_newMessage))
            return;

        var currentUserId = await GetCurrentUserIdAsync();
        if (currentUserId == null)
        {
            await Js.InvokeVoidAsync("alert", "Não foi possível identificar o usuário logado.");
            return;
        }

        var tx = new
        {
            UserSourceId = currentUserId.Value,
            UserTargetId = (int?)null,
            Body = _newMessage,
            TicketId = _selectedTicket.Id,
            CreatedAt = DateTime.UtcNow
        };

        await Http.PostAsJsonAsync("tickettransactions", tx);

        _newMessage = "";

        await LoadTransactions(_selectedTicket.Id);
        await InvokeAsync(StateHasChanged);
        await Js.InvokeVoidAsync("scrollChatToBottom");
    }

    private async Task ReOpen(Ticket ticket)
    {
        try
        {
            var statuses = await Http.GetFromJsonAsync<List<StatusTicketDto>>("statustickets") ?? new();
            var reopen = statuses.FirstOrDefault(s => string.Equals(s.Name, "Em Andamento", StringComparison.OrdinalIgnoreCase));

            if (reopen == null)
            {
                await Js.InvokeVoidAsync("alert", "Status de reabertura não encontrado.");
                return;
            }

            ticket.StatusId = reopen.Id;

            var resp = await Http.PutAsJsonAsync($"tickets/{ticket.Id}", ticket);
            if (!resp.IsSuccessStatusCode)
            {
                await Js.InvokeVoidAsync("alert", $"Falha ao reabrir o chamado: {(int)resp.StatusCode}");
                return;
            }

            var userId = await GetCurrentUserIdAsync();
            if (userId == null)
            {
                await Js.InvokeVoidAsync("alert", "Sessão expirada. Faça login novamente.");
                Nav.NavigateTo("/login", true);
                return;
            }

            try
            {
                _tickets = await Http.GetFromJsonAsync<List<Ticket>>($"tickets/assigned/{userId.Value}/closed") ?? new();
            }
            catch
            {
                try
                {
                    _tickets = await Http.GetFromJsonAsync<List<Ticket>>($"tickets/assigned/{userId.Value}") ?? new();
                }
                catch
                {
                    _tickets = new();
                }
            }

            ApplySorting();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            await Js.InvokeVoidAsync("alert", $"Erro ao reabrir chamado: {ex.Message}");
        }
    }

}

