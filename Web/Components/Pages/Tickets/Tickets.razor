@page "/tickets"
@using Web.Models
@rendermode InteractiveServer
@using System.Net

<PageTitle>Chamados em aberto</PageTitle>

<h1>Chamados em aberto</h1>

@if (_tickets == null)
{
    <div class="d-flex align-items-center text-muted">
        <div class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></div>
        Carregando dados...
    </div>
}
else if (!_tickets.Any())
{
    <p><em>Nenhum chamado em aberto.</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover table-bordered">
            <thead class="table-light">
                <tr>
                    <th class="text-center sortable" @onclick='() => SetSort("Id")'>
                        ID <span class="ms-2 @GetIndicatorClass("Id")">@GetColumnIndicator("Id")</span>
                    </th>
                    <th class="text-center sortable" @onclick='() => SetSort("User")'>
                        Usuário <span class="ms-2 @GetIndicatorClass("User")">@GetColumnIndicator("User")</span>
                    </th>
                    <th class="text-center sortable" @onclick='() => SetSort("Department")'>
                        Departamento <span class="ms-2 @GetIndicatorClass("Department")">@GetColumnIndicator("Department")</span>
                    </th>
                    <th class="text-center sortable" @onclick='() => SetSort("Description")'>
                        Descrição <span class="ms-2 @GetIndicatorClass("Description")">@GetColumnIndicator("Description")</span>
                    </th>
                    <th class="text-center sortable" @onclick='() => SetSort("Category")'>
                        Categoria <span class="ms-2 @GetIndicatorClass("Category")">@GetColumnIndicator("Category")</span>
                    </th>
                    <th class="text-center sortable" @onclick='() => SetSort("Priority")'>
                        Prioridade <span class="ms-2 @GetIndicatorClass("Priority")">@GetColumnIndicator("Priority")</span>
                    </th>
                    <th class="text-center sortable" @onclick='() => SetSort("Status")'>
                        Status <span class="ms-2 @GetIndicatorClass("Status")">@GetColumnIndicator("Status")</span>
                    </th>
                    <th class="text-center sortable" @onclick='() => SetSort("Date")'>
                        Data <span class="ms-2 @GetIndicatorClass("Date")">@GetColumnIndicator("Date")</span>
                    </th>
                    <th class="text-center">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ticket in _sortedTickets)
                {
                    <tr>
                        <td class="text-center">@ticket.Id</td>
                        <td class="text-center">@ticket.User?.Name</td>
                        <td class="text-center">@ticket.Department?.Name</td>
                        <td class="text-center">@ticket.Description</td>
                        <td class="text-center">@ticket.Category?.Description</td>
                        @{
                            var priority = ticket.PriorityLevel.ToString();
                            var priorityValue = priority.ToLowerInvariant();
                            var badgeClass = "bg-primary";

                            switch (priorityValue)
                            {
                                case "alta":
                                case "3":
                                    badgeClass = "bg-danger";
                                    break;
                                case "média":
                                case "2":
                                case "medium":
                                    badgeClass = "bg-warning";
                                    break;
                                case "baixa":
                                case "1":
                                    badgeClass = "bg-success";
                                    break;
                            }
                        }

                        <td class="text-center">
                            <span class="badge @badgeClass">@FormatStatus(priority)</span>
                        </td>
                        <td class="text-center"><span class="badge bg-primary">@FormatStatus(ticket.StatusTicket?.Name)</span></td>
                        <td class="text-center">@ticket.OpenDateTime?.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        <td class="text-center text-nowrap">
                            <div class="d-flex justify-content-center align-items-center">
                                <button class="btn btn-outline-warning btn-sm me-1" @onclick="() => ShowDetails(ticket)" title="Detalhes">
                                    <i class="bi bi-eye"></i> Detalhes
                                </button>
                                @if (!IsAssigned(ticket.Id))
                                {
                                    <button class="btn btn-outline-success btn-sm" @onclick="() => AssignTicket(ticket)" title="Atribuir">
                                        <i class="bi bi-person-plus"></i> Atribuir
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Modal de Detalhes -->
<div class="modal fade" id="detailsModal" tabindex="-1" aria-labelledby="detailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content shadow-lg rounded-3">

            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-semibold" id="detailsModalLabel">
                    Detalhes do Chamado #@(_selectedTicket?.Id)
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-4">
                @if (_selectedTicket != null)
                {
                    <div class="row g-3">

                        <div class="col-12">
                            <label class="fw-bold text-secondary">Descrição</label>
                            <div class="p-3 bg-light rounded border">@_selectedTicket.Description</div>
                        </div>

                        <div class="col-md-6">
                            <label class="fw-bold text-secondary">Usuário</label>
                            <div class="p-2 bg-light rounded border">@_selectedTicket.User?.Name</div>
                        </div>

                        <div class="col-md-6">
                            <label class="fw-bold text-secondary">Departamento</label>
                            <div class="p-2 bg-light rounded border">@_selectedTicket.Department?.Name</div>
                        </div>

                        <div class="col-md-6">
                            <label class="fw-bold text-secondary">Categoria</label>
                            <div class="p-2 bg-light rounded border">@FormatStatus(_selectedTicket.Category?.Description)</div>
                        </div>

                        <div class="col-md-6">
                            <label class="fw-bold text-secondary">Prioridade</label>
                            <div class="p-2 bg-light rounded border">@FormatStatus(_selectedTicket.PriorityLevel.ToString())</div>
                        </div>

                        <div class="col-md-6">
                            <label class="fw-bold text-secondary">Status</label>
                            <div class="p-2 bg-light rounded border">@FormatStatus(_selectedTicket.StatusTicket?.Name)</div>
                        </div>

                        <div class="col-md-6">
                            <label class="fw-bold text-secondary">Data de Abertura</label>
                            <div class="p-2 bg-light rounded border">
                                @_selectedTicket.OpenDateTime?.ToString("dd/MM/yyyy HH:mm:ss")
                            </div>
                        </div>

                        <div class="col-12 mt-2">
                            <label class="fw-bold text-secondary">Anexos (@_attachments.Count)</label>

                            @if (_attachments.Any())
                            {
                                <div class="row g-3 mt-1">
                                    @foreach (var attach in _attachments)
                                    {
                                        var a = attach?.Trim();
                                        if (!string.IsNullOrEmpty(a))
                                        {
                                            <div class="col-md-4 text-center">
                                                <div class="border rounded p-2 bg-white">
                                                    <img src="@ToApiUrl(a)" 
                                                         alt="Anexo do chamado" 
                                                         class="img-fluid rounded" 
                                                         style="max-height:180px" 
                                                         onerror="this.onerror=null; this.src='@ProxyUrl(a)';" />

                                                    <a href="@ToApiUrl(a)" target="_blank" class="btn btn-sm btn-outline-primary mt-2 w-100">
                                                        Download
                                                    </a>
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-muted fst-italic mt-1">Sem anexos</div>
                            }
                        </div>

                    </div>
                }
            </div>

            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fechar</button>
            </div>

        </div>
    </div>
</div>



@code {
    private List<Ticket>? _tickets;
    private Ticket? _selectedTicket;
    private List<CategoryDto> _categories = new();
    private List<UserDto> _users = new();
    private List<TicketTransactionDto> _transactions = new();
    private List<string> _attachments = new();
    private string _newMessage = "";
    private string _selectedUserId = "";

    private string _sortColumn = "Id";
    private bool _sortAscending = true;

    private Dictionary<int, int?> _assignmentByTicket = new();

    [Inject]
    private HttpClient Http { get; set; } = default!;
    [Inject]
    private IJSRuntime Js { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        try { _categories = await Http.GetFromJsonAsync<List<CategoryDto>>("categories") ?? new(); } catch { _categories = new(); }
        try { _users = await Http.GetFromJsonAsync<List<UserDto>>("users") ?? new(); } catch { _users = new(); }
        try { _tickets = await Http.GetFromJsonAsync<List<Ticket>>("tickets"); } catch { _tickets = new(); }

        try
        {
            var assigns = await Http.GetFromJsonAsync<List<AssignmentStatusDto>>("tickets/assignment-status") ?? new();
            _assignmentByTicket = assigns.ToDictionary(a => a.TicketId, a => a.UserTargetId);
        }
        catch { _assignmentByTicket = new(); }

        if (_tickets != null)
        {
            _tickets = _tickets.Where(t => t.StatusTicket?.Name == "Aberto").ToList();
        }
        ApplySorting();
    }

    private string FormatStatus(string? name) => string.Equals(name, "Em Andamento", StringComparison.OrdinalIgnoreCase) ? "Atendendo" : (name ?? "");
    private bool IsAssigned(int ticketId) => _assignmentByTicket.TryGetValue(ticketId, out var uid) && uid.HasValue;

    private async Task ShowDetails(Ticket ticket)
    {
        _selectedTicket = ticket;
        await LoadTicketDetails();
        await LoadAttachments();
        await LoadTransactions();
        await Js.InvokeVoidAsync("eval", "new bootstrap.Modal(document.getElementById('detailsModal')).show()");
    }

    private async Task AssignTicket(Ticket ticket)
    {
        _selectedTicket = ticket;
        var currentUserId = await GetCurrentUserIdAsync();
        if (currentUserId == null)
        {
            await Js.InvokeVoidAsync("alert", "Não foi possível identificar o usuário logado. Faça login novamente.");
            return;
        }

        try
        {
            var tx = new {
                UserSourceId = currentUserId.Value,
                UserTargetId = currentUserId.Value,
                Body = "Chamado atribuído ao técnico.",
                TicketId = _selectedTicket.Id,
                CreatedAt = DateTime.UtcNow
            };
            var resp = await Http.PostAsJsonAsync("tickettransactions", tx);
            if (!resp.IsSuccessStatusCode)
            {
                await Js.InvokeVoidAsync("alert", $"Falha ao atribuir o chamado: {(int)resp.StatusCode}");
                return;
            }
            // Após atribuir, o serviço muda o status para Em aNDAMENTO, então esse chamado sai desta lista
            _tickets = await Http.GetFromJsonAsync<List<Ticket>>("tickets") ?? new();
            _tickets = _tickets.Where(t => t.StatusTicket?.Name == "Aberto").ToList();
            ApplySorting();
        }
        catch (Exception ex)
        {
            await Js.InvokeVoidAsync("alert", $"Erro ao atribuir: {ex.Message}");
        }
    }

    private async Task ShowChat(Ticket ticket)
    {
        _selectedTicket = ticket;
        await LoadTransactions();
        await Js.InvokeVoidAsync("eval", "new bootstrap.Modal(document.getElementById('chatModal')).show()");
    }

    private string ToApiUrl(string path)
    {
        var baseUrl = Http.BaseAddress?.ToString().TrimEnd('/') ?? string.Empty;
        if (string.IsNullOrWhiteSpace(path)) return string.Empty;
        if (Uri.IsWellFormedUriString(path, UriKind.Absolute)) return path;
        if (path.StartsWith('/')) return baseUrl + path;
        return $"{baseUrl}/{path}";
    }

    private string ProxyUrl(string path)
    {
        if (string.IsNullOrWhiteSpace(path)) return string.Empty;
        var trimmed = path.TrimStart('/');
        if (trimmed.StartsWith("uploads", StringComparison.OrdinalIgnoreCase))
        {
            var rest = trimmed.Substring("uploads".Length).TrimStart('/');
            return "/files/" + rest;
        }
        return "/files/" + trimmed;
    }

    private async Task LoadTicketDetails()
    {
        if (_selectedTicket != null)
        {
            try
            {
                var resp = await Http.GetAsync($"tickets/{_selectedTicket.Id}");
                if (resp.IsSuccessStatusCode)
                {
                    var full = await resp.Content.ReadFromJsonAsync<Ticket>();
                    if (full != null) _selectedTicket = full;
                }
            }
            catch
            {
                // Ignorar erros
            }
        }
    }

    private async Task LoadAttachments()
    {
        if (_selectedTicket != null)
        {
            try
            {
                var urls = await Http.GetFromJsonAsync<List<string>>($"tickets/{_selectedTicket.Id}/attachments");
                _attachments = urls?.Select(u => u?.Trim()).Where(u => !string.IsNullOrEmpty(u)).Cast<string>().ToList() ?? new();

                if (_attachments.Count == 0)
                {
                    var resp = await Http.GetAsync($"tickettransactions/ticket/{_selectedTicket.Id}");
                    if (resp.IsSuccessStatusCode)
                    {
                        var txs = await resp.Content.ReadFromJsonAsync<List<TicketTransactionDto>>();
                        var fromTx = txs?.Select(tx => tx.AttachUrl?.Trim()).Where(a => !string.IsNullOrEmpty(a)).Cast<string>().ToList() ?? new();
                        if (fromTx.Count > 0) _attachments = fromTx;
                    }
                }
            }
            catch
            {
                _attachments = new();
            }
        }
    }

    private async Task LoadTransactions()
    {
        if (_selectedTicket != null)
        {
            try
            {
                var resp = await Http.GetAsync($"tickettransactions/ticket/{_selectedTicket.Id}");
                if (resp.IsSuccessStatusCode)
                {
                    _transactions = await resp.Content.ReadFromJsonAsync<List<TicketTransactionDto>>() ?? new();
                }
                else if (resp.StatusCode == HttpStatusCode.NotFound)
                {
                    _transactions = new();
                }
                else
                {
                    _transactions = new();
                }
            }
            catch
            {
                _transactions = new();
            }
        }
    }

    private async Task UpdateTicket()
    {
        if (_selectedTicket != null)
        {
            await Http.PutAsJsonAsync($"tickets/{_selectedTicket.Id}", _selectedTicket);
            // Atualiza a lista de chamados
            _tickets = await Http.GetFromJsonAsync<List<Ticket>>("tickets");
            if (_tickets != null)
            {
                _tickets = _tickets.Where(t => t.StatusTicket?.Name == "Aberto").ToList();
            }
            ApplySorting();
        }
    }

    private async Task AssignToUser()
    {
        if (_selectedTicket != null && int.TryParse(_selectedUserId, out var userId))
        {
            var currentUserId = await GetCurrentUserIdAsync();
            if (currentUserId == null)
            {
                await Js.InvokeVoidAsync("alert", "Não foi possível identificar o usuário logado. Faça login novamente.");
                return;
            }

            var tx = new {
                UserSourceId = currentUserId.Value,
                UserTargetId = userId,
                Body = $"Chamado atribuído ao técnico #{userId}.",
                TicketId = _selectedTicket.Id,
                CreatedAt = DateTime.UtcNow
            };
            await Http.PostAsJsonAsync("tickettransactions", tx);
            _tickets = await Http.GetFromJsonAsync<List<Ticket>>("tickets") ?? new();
            _tickets = _tickets.Where(t => t.StatusTicket?.Name == "Aberto").ToList();
            ApplySorting();
        }
    }

    private async Task SendMessage()
    {
        if (_selectedTicket != null && !string.IsNullOrEmpty(_newMessage))
        {
            var currentUserId = await GetCurrentUserIdAsync();
            if (currentUserId == null)
            {
                await Js.InvokeVoidAsync("alert", "Não foi possível identificar o usuário logado. Faça login novamente.");
                return;
            }

            var tx = new
            {
                UserSourceId = currentUserId.Value,
                UserTargetId = (int?)null,
                Body = _newMessage,
                TicketId = _selectedTicket.Id,
                CreatedAt = DateTime.UtcNow
            };
            await Http.PostAsJsonAsync("tickettransactions", tx);
            _newMessage = "";
            await LoadTransactions();
        }
    }

    private async Task<int?> GetCurrentUserIdAsync()
    {
        try
        {
            var idStr = await Js.InvokeAsync<string>("localStorage.getItem", "userId");
            if (!string.IsNullOrWhiteSpace(idStr) && int.TryParse(idStr, out var id))
            {
                return id;
            }
        }
        catch { }
        return null;
    }

    private void SetSort(string column)
    {
        if (_sortColumn == column)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }

        ApplySorting();
        StateHasChanged();
    }

    private void ApplySorting()
    {
        if (_tickets != null)
        {
            if (_sortColumn == "Id")
            {
                _sortedTickets = _sortAscending ? _tickets.OrderBy(t => t.Id).ToList() : _tickets.OrderByDescending(t => t.Id).ToList();
            }
            else if (_sortColumn == "User")
            {
                _sortedTickets = _sortAscending ? _tickets.OrderBy(t => t.User?.Name).ToList() : _tickets.OrderByDescending(t => t.User?.Name).ToList();
            }
            else if (_sortColumn == "Department")
            {
                _sortedTickets = _sortAscending ? _tickets.OrderBy(t => t.Department?.Name).ToList() : _tickets.OrderByDescending(t => t.Department?.Name).ToList();
            }
            else if (_sortColumn == "Description")
            {
                _sortedTickets = _sortAscending ? _tickets.OrderBy(t => t.Description).ToList() : _tickets.OrderByDescending(t => t.Description).ToList();
            }
            else if (_sortColumn == "Category")
            {
                _sortedTickets = _sortAscending ? _tickets.OrderBy(t => t.Category?.Description).ToList() : _tickets.OrderByDescending(t => t.Category?.Description).ToList();
            }
            else if (_sortColumn == "Priority")
            {
                _sortedTickets = _sortAscending ? _tickets.OrderBy(t => t.PriorityLevel).ToList() : _tickets.OrderByDescending(t => t.PriorityLevel).ToList();
            }
            else if (_sortColumn == "Status")
            {
                _sortedTickets = _sortAscending ? _tickets.OrderBy(t => t.StatusTicket?.Name).ToList() : _tickets.OrderByDescending(t => t.StatusTicket?.Name).ToList();
            }
            else if (_sortColumn == "Date")
            {
                _sortedTickets = _sortAscending ? _tickets.OrderBy(t => t.OpenDateTime).ToList() : _tickets.OrderByDescending(t => t.OpenDateTime).ToList();
            }
        }
    }

    private List<Ticket> _sortedTickets = new();

    private string GetColumnIndicator(string column)
    {
        if (_sortColumn != column) return "";
        return _sortAscending ? "▲" : "▼";
    }

    private string GetIndicatorClass(string column)
    {
        return _sortColumn == column ? "fw-bold" : string.Empty;
    }
}
