@page "/users/create"
@using Web.Models
@inject HttpClient Http
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<h3 class="mb-3"><span class="bi bi-person-plus-fill me-2"></span>Criar Usuário</h3>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger" role="alert">
        <span class="bi bi-exclamation-triangle me-2"></span>@_errorMessage
    </div>
}

@if (_isLoadingLookups)
{
    <div class="d-flex align-items-center text-muted">
        <div class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></div>
        Carregando dados...
    </div>
}
else
{
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10 col-xl-8">
            <EditForm Model="_createModel" OnValidSubmit="HandleCreateSubmit" FormName="CreateUserForm">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger mb-3" />

                <div class="row g-3">
                    <div class="col-12">
                        <h5 class="section-title">Informações básicas</h5>
                        <hr class="section-divider" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Nome <span class="text-danger">*</span></label>
                        <InputText class="form-control" @bind-Value="_createModel.Name" placeholder="Digite o nome completo" />
                        <ValidationMessage For="() => _createModel.Name" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Email <span class="text-danger">*</span></label>
                        <InputText class="form-control" @bind-Value="_createModel.Email" placeholder="email@exemplo.com" />
                        <small class="form-text text-muted">Usado para login e comunicações.</small>
                        <ValidationMessage For="() => _createModel.Email" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Senha <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <InputText class="form-control" type="@(_showPassword ? "text" : "password")" @bind-Value="_createModel.Password" placeholder="Mínimo de 6 caracteres" />
                            <button type="button" class="btn btn-outline-secondary" @onclick="TogglePassword" title="Mostrar/ocultar senha">
                                <span class="bi @( _showPassword ? "bi-eye-slash" : "bi-eye" )"></span>
                            </button>
                        </div>
                        <small class="text-muted">A senha deve ter entre 6 e 100 caracteres.</small>
                        <ValidationMessage For="() => _createModel.Password" />
                    </div>

                    <div class="col-12 mt-2">
                        <h5 class="section-title">Vinculações</h5>
                        <hr class="section-divider" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Departamento <span class="text-danger">*</span></label>
                        <InputSelect class="form-select" @bind-Value="_createModel.DeptId">
                            <option value="0">-- selecione --</option>
                            @foreach (var d in _depts)
                            {
                                <option value="@d.Id">@d.Name</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => _createModel.DeptId" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Perfil <span class="text-danger">*</span></label>
                        <InputSelect class="form-select" @bind-Value="_createModel.ProfileId">
                            <option value="0">-- selecione --</option>
                            @foreach (var p in _profiles)
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => _createModel.ProfileId" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Status <span class="text-danger">*</span></label>
                        <InputSelect class="form-select" @bind-Value="_createModel.UserStatusId">
                            <option value="0">-- selecione --</option>
                            @foreach (var s in _statuses)
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => _createModel.UserStatusId" />
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <button class="btn btn-secondary" type="button" @onclick="GoBack">
                        <span class="bi bi-arrow-left me-1"></span> Voltar
                    </button>
                    <button class="btn btn-primary" type="submit" disabled="@_isSubmitting">
                        @if (_isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        }
                        <span class="bi bi-check2-circle me-1"></span> Criar
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private CreateUserDto _createModel = new();
    private List<DepartmentDto> _depts = new();
    private List<UserProfileDto> _profiles = new();
    private List<UserStatusDto> _statuses = new();
    private string? _errorMessage;
    private bool _isLoadingLookups = true;
    private bool _isSubmitting = false;
    private bool _showPassword = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadLookupAsync();
        _isLoadingLookups = false;
    }

    private async Task LoadLookupAsync()
    {
        try
        {
            _depts = await Http.GetFromJsonAsync<List<DepartmentDto>>("/departments") ?? new List<DepartmentDto>();
            _profiles = await Http.GetFromJsonAsync<List<UserProfileDto>>("/profiles") ?? new List<UserProfileDto>();
            _statuses = await Http.GetFromJsonAsync<List<UserStatusDto>>("/userstatuses") ?? new List<UserStatusDto>();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task HandleCreateSubmit()
    {
        _errorMessage = null;

        // validações complementares para selects (evitar valor 0)
        if (_createModel.DeptId <= 0)
        {
            _errorMessage = "Selecione um Departamento.";
            return;
        }
        if (_createModel.ProfileId <= 0)
        {
            _errorMessage = "Selecione um Perfil.";
            return;
        }
        if (_createModel.UserStatusId <= 0)
        {
            _errorMessage = "Selecione um Status.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_createModel.Name))
        {
            _errorMessage = "O campo Nome é obrigatório.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_createModel.Email))
        {
            _errorMessage = "O campo Email é obrigatório.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_createModel.Password))
        {
            _errorMessage = "O campo Senha é obrigatório.";
            return;
        }

        try
        {
            _isSubmitting = true;

            var payload = new
            {
                Name = _createModel.Name?.Trim(),
                Email = _createModel.Email?.Trim(),
                Password = _createModel.Password,
                DeptId = _createModel.DeptId,
                UserStatusId = _createModel.UserStatusId,
                ProfileId = _createModel.ProfileId
            };

            Console.WriteLine($"DEBUG -> Creating user payload: {System.Text.Json.JsonSerializer.Serialize(payload)}");
            var response = await Http.PostAsJsonAsync("/users", payload);
            if (response.IsSuccessStatusCode)
            {
                NavigationManager.NavigateTo("/users");
                return;
            }
            else
            {
                var text = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"DEBUG -> Create user response: {text}");
                // Tentar interpretar ProblemDetails/validation errors
                try
                {
                    using var doc = System.Text.Json.JsonDocument.Parse(text);
                    if (doc.RootElement.TryGetProperty("errors", out var errors))
                    {
                        var sb = new System.Text.StringBuilder();
                        foreach (var prop in errors.EnumerateObject())
                        {
                            foreach (var msg in prop.Value.EnumerateArray())
                            {
                                sb.AppendLine(msg.GetString());
                            }
                        }
                        _errorMessage = sb.ToString();
                    }
                    else
                    {
                        _errorMessage = text;
                    }
                }
                catch
                {
                    _errorMessage = text;
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void TogglePassword() => _showPassword = !_showPassword;

    private void GoBack()
    {
        NavigationManager.NavigateTo("/users");
    }
}
