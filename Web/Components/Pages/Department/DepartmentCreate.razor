@page "/departments/create"
@using Web.Models
@inject HttpClient Http
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<h3 class="mb-3"><span class="bi bi-building-add me-2"></span>Criar Departamento</h3>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger" role="alert">
        <span class="bi bi-exclamation-triangle me-2"></span>@_errorMessage
    </div>
}

<EditForm Model="_model" OnValidSubmit="HandleSubmit" FormName="CreateDepartmentForm">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger mb-3" />

    <div class="row justify-content-center">
        <div class="col-12 col-lg-10 col-xl-8">
            <div class="row g-3">
                <div class="col-12">
                    <h5 class="section-title">Informações do departamento</h5>
                    <hr class="section-divider" />
                </div>

                <div class="col-md-8">
                    <label class="form-label">Nome <span class="text-danger">*</span></label>
                    <InputText class="form-control" @bind-Value="_model.Name" placeholder="Ex.: Suporte" />
                    <ValidationMessage For="() => _model.Name" />
                </div>

                <div class="col-md-4 d-flex align-items-end">
                    <div class="form-check">
                        <InputCheckbox class="form-check-input" @bind-Value="_model.AcceptTicket" />
                        <label class="form-check-label">Aceita chamados</label>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <button class="btn btn-outline-secondary" type="button" @onclick="GoBack">
                    <span class="bi bi-arrow-left me-1"></span> Voltar
                </button>
                <button class="btn btn-outline-success" type="submit" disabled="@_isSubmitting">
                    @if (_isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    }
                    <span class="bi bi-check2-circle me-1"></span> Criar
                </button>
            </div>
        </div>
    </div>
</EditForm>

@if (_showSuccessModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Departamento criado</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <p>O departamento "<strong>@_createdName</strong>" foi criado com sucesso.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" @onclick="CloseModal">Fechar</button>
                    <button class="btn btn-outline-primary" @onclick="NavigateToList">Ver lista</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private CreateDepartmentDto _model = new();
    private string? _errorMessage;
    private bool _isSubmitting;
    private bool _showSuccessModal;
    private string? _createdName;

    private async Task HandleSubmit()
    {
        _errorMessage = null;
        if (string.IsNullOrWhiteSpace(_model.Name))
        {
            _errorMessage = "Informe o nome do departamento.";
            return;
        }

        try
        {
            _isSubmitting = true;
            var payload = new { Name = _model.Name?.Trim(), AcceptTicket = _model.AcceptTicket };
            var response = await Http.PostAsJsonAsync("/departments", payload);
            if (response.IsSuccessStatusCode)
            {
                _createdName = payload.Name;
                _showSuccessModal = true;
                return;
            }
            var text = await response.Content.ReadAsStringAsync();
            try
            {
                var map = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(text);
                if (map != null && (map.TryGetValue("message", out var m) || map.TryGetValue("Message", out m)))
                {
                    _errorMessage = m;
                }
                else
                {
                    _errorMessage = text;
                }
            }
            catch
            {
                _errorMessage = text;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void GoBack() => NavigationManager.NavigateTo("/");

    private void CloseModal()
    {
        _showSuccessModal = false;
        _createdName = null;
        StateHasChanged();
    }

    private void NavigateToList()
    {
        NavigationManager.NavigateTo("/departments");
    }
}
