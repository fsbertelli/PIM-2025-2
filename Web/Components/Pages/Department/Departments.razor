@page "/departments"
@using Web.Models
@inject HttpClient Http
@rendermode InteractiveServer

<style>
.list-container { display:flex; flex-direction:column; gap:1rem; }
.search-row { display:flex; gap:0.5rem; align-items:center; margin-bottom:0.75rem; }
.search-row .form-control { flex:1; }
.table thead { background:#f8f9fa; }
</style>

<h3>Departamentos</h3>

<div class="list-container">
    <div class="search-row">
        <input class="form-control" placeholder="Buscar por nome" value="@_search" @oninput="OnSearchInput" />
        <button class="btn btn-outline-light" @onclick="ClearFilter">Limpar</button>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger" role="alert">@_errorMessage</div>
    }

    @if (_isLoading)
    {
        <div class="d-flex align-items-center text-muted">
            <div class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></div>
            Carregando dados...
        </div>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nome</th>
                    <th>Aceita Chamados</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in _filtered)
                {
                    <tr>
                        <td>@d.Id</td>
                        <td>@d.Name</td>
                        <td>
                            @if (d.AcceptTicket)
                            {
                                <span class="badge bg-success">Sim</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Não</span>
                            }
                        </td>
                        <td>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => OpenConfirmDelete(d.Id, d.Name)" disabled="@(!_isAdmin)">Remover</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (_showConfirmModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar remoção</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseConfirm"></button>
                </div>
                <div class="modal-body">
                    <p>Confirma remoção de &quot;<strong>@_confirmName</strong>&quot; (id: @_confirmId)?</p>
                    <p class="text-muted">A ação não pode ser desfeita.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseConfirm">Cancelar</button>
                    <button class="btn btn-danger" @onclick="ConfirmDelete">Remover</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<DepartmentDto> _items = new();
    private List<DepartmentDto> _filtered = new();
    private string _search = string.Empty;
    private bool _isLoading = true;
    private string? _errorMessage;
    // modal
    private bool _showConfirmModal;
    private int _confirmId;
    private string? _confirmName;
    //perfil
    private bool _isAdmin;
    //dependencias
    [Inject]
    private IJSRuntime Js { get; set; } = default!;
    
    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var flag = await Js.InvokeAsync<string>("localStorage.getItem", "isAdmin");
            _isAdmin = flag == "1";
            StateHasChanged();
        }
    }
    
    private async Task LoadDataAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            _items = await Http.GetFromJsonAsync<List<DepartmentDto>>("/departments") ?? new();
            _filtered = _items.ToList();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e?.Value?.ToString() ?? string.Empty;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var department = _search.Trim().ToLowerInvariant();
        _filtered = string.IsNullOrEmpty(department)
            ? _items.ToList()
            : _items.Where(d => (d.Name ?? string.Empty).ToLower().Contains(department)).ToList();
        StateHasChanged();
    }

    private void ClearFilter()
    {
        _search = string.Empty;
        _filtered = _items.ToList();
    }

    private void OpenConfirmDelete(int id, string? name)
    {
        _confirmId = id;
        _confirmName = name;
        _showConfirmModal = true;
    }

    private void CloseConfirm()
    {
        _showConfirmModal = false;
        _confirmId = 0;
        _confirmName = null;
    }

    private async Task ConfirmDelete()
    {
        _showConfirmModal = false;
        try
        {
            var resp = await Http.DeleteAsync($"/departments/{_confirmId}");
            if (resp.IsSuccessStatusCode)
            {
                await LoadDataAsync();
            }
            else
            {
                var text = await resp.Content.ReadAsStringAsync();
                _errorMessage = $"Erro ao remover: {(int)resp.StatusCode} - {text}";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _confirmId = 0;
            _confirmName = null;
        }
    }
}
