@page "/users"
@using Web.Models
@inject HttpClient Http
@inject IJSRuntime Js
@rendermode InteractiveServer

<style>
.users-container { display: flex; flex-direction: column; gap: 1rem; }
.search-row { display:flex; gap:0.5rem; align-items:center; margin-bottom:0.75rem; }
.search-row .form-control { flex:1; }
.table thead { background:#f8f9fa; }
</style>

<h3>Listar Usuários</h3>

<div class="users-container">
    <div class="search-row">
        <input class="form-control" placeholder="Buscar por nome ou email" value="@_search" @oninput="OnSearchInput" />
        <button class="btn" @onclick="ClearFilter">Limpar</button>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="error-label">@_errorMessage</div>
    }

    @if (_isLoading)
    {
        <div class="d-flex align-items-center text-muted">
            <div class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></div>
            Carregando dados...
        </div>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nome</th>
                    <th>Email</th>
                    <th>Departamento</th>
                    <th>Perfil</th>
                    <th>Status</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in _filtered)
                {
                    <tr>
                        <td>@u.Id</td>
                        <td>@u.Name</td>
                        <td>@u.Email</td>
                        <td>@u.Department?.Name</td>
                        <td>@u.UserProfile?.Name</td>
                        <td>@u.UserStatus?.Name</td>
                        <td>
                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteUser(u.Id)">Remover</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<UserDto> _users = new();
    private List<UserDto> _filtered = new();

    private string _search = string.Empty;
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            _users = await Http.GetFromJsonAsync<List<UserDto>>("/users") ?? new List<UserDto>();
            _filtered = _users.ToList();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e?.Value?.ToString() ?? string.Empty;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var q = _search.Trim().ToLowerInvariant();
        if (string.IsNullOrEmpty(q))
        {
            _filtered = _users.ToList();
        }
        else
        {
            _filtered = _users.Where(u => (u.Name ?? string.Empty).ToLower().Contains(q) || (u.Email ?? string.Empty).ToLower().Contains(q)).ToList();
        }
        StateHasChanged();
    }

    private void ClearFilter()
    {
        _search = string.Empty;
        _filtered = _users.ToList();
    }

    private async Task DeleteUser(int id)
    {
        var ok = await Js.InvokeAsync<bool>("confirm", $"Confirma remoção do usuário {id}?\nA ação não pode ser desfeita.");
        if (!ok) return;
        try
        {
            var resp = await Http.DeleteAsync($"/users/{id}");
            if (resp.IsSuccessStatusCode)
            {
                await LoadDataAsync();
            }
            else
            {
                var text = await resp.Content.ReadAsStringAsync();
                _errorMessage = $"Erro ao remover: {(int)resp.StatusCode} - {text}";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }
}
