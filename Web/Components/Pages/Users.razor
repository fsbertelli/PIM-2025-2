@page "/users"
@using Web.Models
@using System.Threading
@inject HttpClient Http
@inject IJSRuntime Js

<style>
.users-container { display: flex; flex-direction: column; gap: 1rem; }
.search-row { display:flex; gap:0.5rem; align-items:center; margin-bottom:0.75rem; }
.search-row .form-control { flex:1; }
.table thead { background:#f8f9fa; }
.edit-panel { margin-top:1rem; padding:1rem; border:1px solid #e3e6ea; border-radius:6px; background:#fff; }
.user-nav { margin-bottom:0.75rem; }
</style>
<UserNav />

<h3>Listar Usuários</h3>

<div class="users-container">
    <div class="search-row">
        <input class="form-control" placeholder="Buscar por nome ou email" value="@_search" @oninput="OnSearchInput" />
        <button class="btn" @onclick="ClearFilter">Limpar</button>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="error-label">@_errorMessage</div>
    }

    @if (_isLoading)
    {
        <div>Carregando...</div>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nome</th>
                    <th>Email</th>
                    <th>Departamento</th>
                    <th>Perfil</th>
                    <th>Status</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in _filtered)
                {
                    <tr>
                        <td>@u.Id</td>
                        <td>@u.Name</td>
                        <td>@u.Email</td>
                        <td>@u.Department?.Name</td>
                        <td>@u.UserProfile?.Name</td>
                        <td>@u.UserStatus?.Name</td>
                        <td>
                            <button class="btn btn-sm" @onclick="() => StartEdit(u)">Editar</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteUser(u.Id)">Remover</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (_isEditing)
    {
        <div class="edit-panel">
            <h4>Editar Usuário</h4>
            <EditForm Model="_updateModel" OnValidSubmit="HandleEditSubmit" FormName="EditUserForm">
                <DataAnnotationsValidator />
                <div class="row">
                    <div class="col-md-6 form-group">
                        <label>Nome</label>
                        <input class="form-control" @bind="_updateModel.Name" disabled />
                    </div>
                    <div class="col-md-6 form-group">
                        <label>Email</label>
                        <input class="form-control" @bind="_updateModel.Email" />
                        <ValidationMessage For="() => _updateModel.Email" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 form-group">
                        <label>Senha (deixe em branco para manter)</label>
                        <input type="password" class="form-control" @bind="_updateModel.Password" />
                        <ValidationMessage For="() => _updateModel.Password" />
                    </div>
                    <div class="col-md-6 form-group">
                        <label>Departamento</label>
                        <select class="form-control" @bind="_updateModel.DeptId">
                            <option value="0">-- selecione --</option>
                            @foreach (var d in _depts)
                            {
                                <option value="@d.Id">@d.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="form-actions mt-2">
                    <button class="btn btn-primary" type="submit">Salvar</button>
                    <button class="btn" type="button" @onclick="CancelEdit">Cancelar</button>
                </div>
            </EditForm>
        </div>
    }
</div>

@code {
    private List<UserDto> _users = new();
    private List<UserDto> _filtered = new();
    private List<DepartmentDto> _depts = new();
    private List<UserProfileDto> _profiles = new();
    private List<UserStatusDto> _statuses = new();

    private string _search = string.Empty;
    private bool _isLoading = true;
    private bool _isEditing = false;
    private int _editingId;
    private string? _errorMessage;

    private UpdateUserDto _updateModel = new();
    private CancellationTokenSource? _searchCts;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            _users = await Http.GetFromJsonAsync<List<UserDto>>("/users") ?? new List<UserDto>();
            _depts = await Http.GetFromJsonAsync<List<DepartmentDto>>("/departments") ?? new List<DepartmentDto>();
            _profiles = await Http.GetFromJsonAsync<List<UserProfileDto>>("/profiles") ?? new List<UserProfileDto>();
            _statuses = await Http.GetFromJsonAsync<List<UserStatusDto>>("/userstatuses") ?? new List<UserStatusDto>();
            _filtered = _users.ToList();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e?.Value?.ToString() ?? string.Empty;
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(350, token);
                if (token.IsCancellationRequested) return;
                await InvokeAsync(ApplyFilter);
            }
            catch (TaskCanceledException) { }
        });
    }

    private void ApplyFilter()
    {
        var q = _search.Trim().ToLowerInvariant();
        if (string.IsNullOrEmpty(q))
        {
            _filtered = _users.ToList();
        }
        else
        {
            _filtered = _users.Where(u => (u.Name ?? string.Empty).ToLower().Contains(q) || (u.Email ?? string.Empty).ToLower().Contains(q)).ToList();
        }
        StateHasChanged();
    }

    private void ClearFilter()
    {
        _search = string.Empty;
        _filtered = _users.ToList();
    }

    private void StartEdit(UserDto user)
    {
        _isEditing = true;
        _editingId = user.Id;
        _updateModel = new UpdateUserDto
        {
            Name = user.Name,
            Email = user.Email,
            DeptId = user.Department?.Id ?? 0,
            ProfileId = user.UserProfile?.Id ?? 0,
            UserStatusId = user.UserStatus?.Id ?? 0,
            Password = null
        };
    }

    private void CancelEdit()
    {
        _isEditing = false;
        _editingId = 0;
        _updateModel = new UpdateUserDto();
    }

    private async Task HandleEditSubmit()
    {
        _errorMessage = null;
        try
        {
            var response = await Http.PutAsJsonAsync($"/users/{_editingId}", _updateModel);
            if (response.IsSuccessStatusCode)
            {
                await LoadDataAsync();
                CancelEdit();
                return;
            }
            else
            {
                var text = await response.Content.ReadAsStringAsync();
                _errorMessage = $"Erro ao atualizar: {(int)response.StatusCode} - {text}";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task DeleteUser(int id)
    {
        var ok = await Js.InvokeAsync<bool>("confirm", $"Confirma remoção do usuário {id}?\nA ação não pode ser desfeita.");
        if (!ok) return;
        try
        {
            var resp = await Http.DeleteAsync($"/users/{id}");
            if (resp.IsSuccessStatusCode)
            {
                await LoadDataAsync();
            }
            else
            {
                var text = await resp.Content.ReadAsStringAsync();
                _errorMessage = $"Erro ao remover: {(int)resp.StatusCode} - {text}";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }
}
