@inherits LayoutComponentBase

<div class="page">
<header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm py-3">
        <div class="container-fluid px-4">
            <!-- Logo -->
            <NavLink class="navbar-brand d-flex align-items-center" href="/tickets">
                <span class="bi bi-gear-fill me-2" style="font-size:1.5rem;"></span>
                Sigma Web
            </NavLink>

            <!-- Botão hamburger -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Links de navegação -->
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <!-- Menu Chamado -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="menuChamado" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="bi bi-ticket-fill me-1"></span>
                            Chamado
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="menuChamado">
                            <li>
                                <NavLink class="dropdown-item" href="/tickets" Match="NavLinkMatch.All">Chamados em aberto</NavLink>
                            </li>
                            <li>
                                <NavLink class="dropdown-item" href="/my-tickets" Match="NavLinkMatch.All">Meus chamados</NavLink>
                            </li>
                            <li>
                                <NavLink class="dropdown-item" href="/closed-tickets" Match="NavLinkMatch.All">Histórico de chamados</NavLink>
                            </li>
                        </ul>
                    </li>

                    <!-- Menu Cadastro -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="menuCadastro" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="bi bi-journal-plus me-1"></span>
                            Cadastro
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="menuCadastro">
                            <li>
                                <NavLink class="dropdown-item" href="/users/create" Match="NavLinkMatch.All">Criar usuário</NavLink>
                            </li>
                            <li>
                                <NavLink class="dropdown-item" href="/departments/create" Match="NavLinkMatch.All">Criar departamento</NavLink>
                            </li>
                            <li>
                                <NavLink class="dropdown-item" href="/profiles/create" Match="NavLinkMatch.All">Criar perfil</NavLink>
                            </li>
                            <li>
                                <NavLink class="dropdown-item" href="/userstatuses/create" Match="NavLinkMatch.All">Criar status de usuário</NavLink>
                            </li>
                        </ul>
                    </li>

                    <!-- Menu Relatório -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="menuRelatorio" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="bi bi-graph-up me-1"></span>
                            Relatório
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="menuRelatorio">
                            <li>
                                <NavLink class="dropdown-item" href="/users" Match="NavLinkMatch.All">Usuários Cadastrados</NavLink>
                            </li>
                            <li>
                                <NavLink class="dropdown-item" href="/departments" Match="NavLinkMatch.All">Departamentos</NavLink>
                            </li>
                            <li>
                                <NavLink class="dropdown-item" href="/profiles" Match="NavLinkMatch.All">Perfis</NavLink>
                            </li>
                            <li>
                                <NavLink class="dropdown-item" href="/userstatuses" Match="NavLinkMatch.All">Status de Usuário</NavLink>
                            </li>
                        </ul>
                    </li>
                </ul>

                <!-- Menu do usuário -->
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown"
                           role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="bi bi-person-circle me-2" style="font-size:1.5rem;"></span>
                            <UserDisplay />
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="userDropdown">
                            <li>
                                <a class="dropdown-item d-flex align-items-center" href="#" @onclick="Logout">
                                    <span class="bi bi-box-arrow-right me-2"></span> Sair
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>


    <main class="mt-2">
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [Inject] private IJSRuntime Js { get; set; } = default!;
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    private async Task Logout()
    {
        try
        {
            await Js.InvokeVoidAsync("localStorage.removeItem", "isLoggedIn");
            await Js.InvokeVoidAsync("localStorage.removeItem", "savedEmail");
            await Js.InvokeVoidAsync("localStorage.removeItem", "savedPassword");
            await Js.InvokeVoidAsync("localStorage.removeItem", "savedName");
            // Clear stored userId as well
            await Js.InvokeVoidAsync("localStorage.removeItem", "userId");
        }
        catch { }
        NavigationManager.NavigateTo("/login", true);
    }
}
